<h1 class="text-3xl">Game of LiveView</h1>
<form id="form" phx-change="resize">
  <.input class="w-20 input" type="number" min="1" name="size" label="Size" value={@size} />
</form>
<svg
  class="m-3"
  viewBox={"0 0 #{@size} #{@size}"}
  xmlns="http://www.w3.org/2000/svg"
  height="90vmin"
  width="90vmin"
>
  <%= for x <- 0..(@size-1), y <- 0..(@size-1) do %>
    <rect
      id={"square-#{x}-#{y}"}
      x={x}
      y={y}
      width="1"
      height="1"
      stroke="silver"
      stroke-width="0.1%"
      fill="white"
      phx-click="add-cell"
      phx-value-x={x}
      phx-value-y={y}
    />
  <% end %>
  <rect
    x="0"
    y="0"
    width={@size}
    height={@size}
    stroke="black"
    stroke-width="0.5%"
    fill="none"
  />
  <rect
    :for={{x, y} <- @cells}
    id={"cell-#{x}-#{y}"}
    x={x}
    y={y}
    width="1"
    height="1"
    fill="black"
    phx-click="remove-cell"
    phx-value-x={x}
    phx-value-y={y}
  />
</svg>
